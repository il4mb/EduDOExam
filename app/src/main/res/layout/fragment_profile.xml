<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".ui.dashboard.profile.ProfileFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <com.il4mb.edudoexam.components.ui.AppBarContent
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="@dimen/dp_14">
            <RelativeLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                tools:ignore="UselessParent"
                android:clipToPadding="false">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/user_photo_view"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/baseline_person_24"
                    android:background="@color/gray"
                    app:shapeAppearanceOverlay="@style/ImageView.Rounded" />
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:padding="5dp"
                    android:src="@drawable/img_male"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    app:tint="@color/white"/>
            </RelativeLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="{USER EMAIL}"
                android:id="@+id/user_email_view"
                android:textSize="11sp"
                android:textColor="@color/white"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="{USER NAME}"
                android:id="@+id/user_name_view"
                android:textColor="@color/white"/>
        </LinearLayout>
    </com.il4mb.edudoexam.components.ui.AppBarContent>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:padding="@dimen/dp_14"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_exams"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/secondary"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/exams_recycle_view"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                android:orientation="horizontal"/>
            <TextView
                android:id="@+id/exams_empty_state"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:textSize="@dimen/text_md"
                android:textStyle="bold"
                android:gravity="center"
                android:text="You Have No Exams"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_package"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/secondary"/>

            <LinearLayout
                android:id="@+id/pacake_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="15dp">
                <TextView
                    android:id="@+id/remaining_quota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/remaining_quota_d"
                    android:paddingHorizontal="@dimen/dp_14"
                    android:paddingVertical="22dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/secondary"/>

                <include android:id="@+id/current_package_layout" layout="@layout/view_item_package"/>

                <TextView
                    android:id="@+id/see_another_packages"
                    android:layout_gravity="end"
                    android:layout_marginEnd="14dp"
                    android:textColor="@color/secondary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/another_packages"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>



